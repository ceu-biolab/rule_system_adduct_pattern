{
  "dataset_id": "martinez_iterative_pilot",
  "inputs": [
    {
      "path": "../../data/martinez_et_al/NIST_Iterative_20ev_1_POS.mzML",
      "polarity": "POSITIVE"
    },
    {
      "path": "../../data/martinez_et_al/NIST_Iterative_20ev_1_NEG.mzML",
      "polarity": "NEGATIVE"
    }
  ],
  "output_dir": "../results/martinez_pilot",
  "preprocessing": {
    "mass_error_ppm": 10.0,
    "noise_threshold_int": 5000.0,
    "chrom_peak_snr": 3.0,
    "min_trace_points": 5,
    "min_trace_length_seconds": 0.0,
    "min_feature_height": 1400.0,
    "charge_lower_bound": 1,
    "charge_upper_bound": 2,
    "isotope_filtering_model": "metabolites (5% RMS)",
    "xic_absolute_tolerance_da": 0.02,
    "xic_tolerance_ppm": 10.0
  },
  "grouping": {
    "rt_tolerance_seconds": 1.2,
    "minimum_rt_overlap": 0.6,
    "minimum_common_points": 5,
    "minimum_pearson_correlation": 0.7
  },
  "annotation": {
    "input_json": "../results/martinez_pilot/feature_groups.json",
    "output_dir": "../results/martinez_pilot/annotation",
    "api": {
      "base_url": "http://localhost:9090",
      "tolerance_mode": "PPM",
      "tolerance": 10.0,
      "timeout_seconds": 60.0
    },
    "database": {
      "conninfo": "dbname=compounds user=alberto",
      "schema": "public",
      "table": "compounds",
      "mass_tolerance_ppm": 10.0,
      "connect_timeout_seconds": 5
    }
  },
  "rule_execution": {
    "input_json": "../results/martinez_pilot/annotation/compound_annotations.json",
    "output_dir": "../results/martinez_pilot/rules",
    "rule_resources_dir": "../../src/main/resources/rules",
    "api": {
      "base_url": "http://localhost:9090",
      "timeout_seconds": 60.0,
      "max_retries": 2
    },
    "mobile_phases": ["NH4", "CH3OH"],
    "sample_type": "PLASMA",
    "tolerance_mode": "PPM",
    "tolerance": 10.0
  },
  "future_annotation_context": {
    "sample_type": "PLASMA",
    "mobile_phases": ["NH4", "CH3OH"],
    "analytical_note": "10 mM CH3COONH4 and 0.2 mM NH4F in H2O/MeOH (9:1, v/v)"
  }
}
