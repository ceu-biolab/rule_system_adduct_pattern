rule "Cer_PositiveCheck - Intensity [M+C2H7N2]+ > [M+Na]+"
when
    $adduct2: ResultItem(adductName == "[M+Na]+")
    $adduct1: ResultItem(adductName == "[M+C2H7N2]+")
    $phase1 : MobilePhases() from mobilePhases
    eval($phase1 == MobilePhases.NH4)
    $phase2 : MobilePhases() from mobilePhases
